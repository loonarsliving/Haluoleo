{
  "rewrites": [
    { "source": "/al-fath-makassar",  "destination": "/al-fath-makassar.html" },
    { "source": "/griya-cariu-indah", "destination": "/griya-cariu-indah.html" },
    { "source": "/direktur",          "destination": "/direktur.html" },
    { "source": "/beauty",            "destination": "/beauty.html" },
    { "source": "/kontak",            "destination": "/kontak.html" },
    { "source": "/admin",             "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
